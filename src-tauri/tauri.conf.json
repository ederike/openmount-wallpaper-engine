{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMount",
  "version": "0.2.1",
  "identifier": "dev.openmount.omwe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenMount Wallpaper Engine",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "visible": true,
        "decorations": true
      },
      {
        "label": "wallpaper",
        "title": "OMWE Wallpaper",
        "url": "wallpaper.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "resizable": false,
        "focus": false,
        "fullscreen": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data: https://asset.localhost; media-src 'self' asset: http://asset.localhost blob: https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 https://api.github.com https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"]
        }
      }
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "OpenMount Wallpaper Engine"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "category": "Entertainment",
    "copyright": "Copyright (C) 2026 OpenMount contributors",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "shortDescription": "Mount-mapped wallpaper engine",
    "longDescription": "OpenMount Wallpaper Engine maps local image and video libraries into a virtual tree, then plays them as a traditional slideshow or a scrolling canvas wallpaper.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4OEQ1N0RCNDY4NzFCNTEKUldSUkc0ZEcyMWVOeUVZUC82L01WWXdFV2FHZjB3NzBidDhoVVdkdkhoY2JQSVNnUXdHc1BzRzMK",
      "endpoints": [
        "https://github.com/ederike/openmount-wallpaper-engine/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
